{
  "protocol": "open-reading-source",
  "protocolVersion": "1.4",
  "supportedVersions": ["1.4"],
  "id": "org.example.public-books",
  "name": "Example Public Books",
  "description": "A minimal Open Reading compatible source",
  "apiBaseUrl": "https://books.example.org/api/",
  "iconUrl": "https://books.example.org/icon.png",
  "websiteUrl": "https://books.example.org/",
  "operatorName": "Example Public Books Foundation",
  "contactUrl": "https://books.example.org/rights",
  "contentLicense": "Public Domain",
  "rightsStatement": "This source serves public-domain books verified by its operator.",
  "languages": ["zh-CN", "en"],
  "maxCatalogPageSize": 500,
  "capabilities": [
    "search",
    "discover",
    "categories",
    "browse",
    "detail",
    "catalog",
    "content"
  ]
}
