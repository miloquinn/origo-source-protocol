{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miloquinn/origo-source-protocol/registry/schemas/source-status.schema.json",
  "title": "ORSP Registry Source Diagnostic Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "checkedAt", "profile", "status", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 3, "maxLength": 200, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "profile": { "type": "string", "enum": ["core-reading", "discovery"] },
    "status": { "type": "string", "enum": ["verified", "degraded", "offline", "unknown"] },
    "protocolVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "failed", "skipped"] },
          "latencyMs": { "type": "integer", "minimum": 0 },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 50 }
  }
}
