{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miloquinn/origo-source-protocol/schemas/discovery.schema.json",
  "title": "Origo Source Discovery Document",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol",
    "protocolVersion",
    "id",
    "name",
    "apiBaseUrl",
    "capabilities"
  ],
  "properties": {
    "protocol": {
      "enum": ["origo-source", "open-reading-source"],
      "description": "origo-source is canonical; open-reading-source is a legacy compatibility identifier."
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "apiBaseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^@/?#\\s]+(?:/[^?#\\s]*)?/$"
    },
    "iconUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "languages": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35,
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      }
    },
    "supportedVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*\\.(?:0|[1-9][0-9]*)$"
      }
    },
    "maxCatalogPageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "operatorName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contactUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "contentLicense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "rightsStatement": {
      "type": "string",
      "maxLength": 2000
    },
    "capabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 64,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "search"
          }
        },
        {
          "contains": {
            "const": "detail"
          }
        },
        {
          "contains": {
            "const": "catalog"
          }
        },
        {
          "contains": {
            "const": "content"
          }
        }
      ],
      "items": {
        "anyOf": [
          {
            "enum": [
              "search",
              "discover",
              "categories",
              "browse",
              "rankings",
              "detail",
              "catalog",
              "content"
            ]
          },
          {
            "type": "string",
            "pattern": "^(?!orsp(?:[.:]|$))[a-z0-9]+(?:[.-][a-z0-9]+)+:[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          }
        ]
      }
    },
    "contentTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
        "not": {
          "const": "application/epub+zip"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "categories"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "browse"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "top.xxread:image-sequence"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "contentTypes"
        ],
        "properties": {
          "contentTypes": {
            "contains": {
              "const": "image/sequence"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "top.xxread:remote-audio"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "contentTypes"
        ],
        "properties": {
          "contentTypes": {
            "contains": {
              "const": "audio/uri"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "contentTypes"
        ],
        "properties": {
          "contentTypes": {
            "contains": {
              "const": "image/sequence"
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "top.xxread:image-sequence"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "contentTypes"
        ],
        "properties": {
          "contentTypes": {
            "contains": {
              "const": "audio/uri"
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "top.xxread:remote-audio"
            }
          }
        }
      }
    }
  ]
}
