{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miloquinn/origo-source-protocol/schemas/media-reading.schema.json",
  "title": "ORSP 1.6 media reading experiment",
  "$defs": {
    "HttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "Headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Referer": {
          "$ref": "#/$defs/HttpUrl"
        },
        "Origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@\\s]+/?$"
        },
        "Accept": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[\\x20-\\x7e]+$"
        }
      }
    },
    "Image": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/HttpUrl"
        },
        "headers": {
          "$ref": "#/$defs/Headers"
        },
        "mimeType": {
          "type": "string",
          "pattern": "^image/[a-zA-Z0-9.+-]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "alt": {
          "type": "string",
          "maxLength": 2000
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Audio": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/HttpUrl"
        },
        "headers": {
          "$ref": "#/$defs/Headers"
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 315360000
        },
        "transport": {
          "enum": [
            "file",
            "hls"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ImageContent": {
      "type": "object",
      "required": [
        "bookId",
        "chapterId",
        "title",
        "contentType",
        "content",
        "images"
      ],
      "properties": {
        "bookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentType": {
          "const": "image/sequence"
        },
        "content": {
          "const": ""
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/Image"
          }
        },
        "audio": false,
        "contentVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "AudioContent": {
      "type": "object",
      "required": [
        "bookId",
        "chapterId",
        "title",
        "contentType",
        "content",
        "audio"
      ],
      "properties": {
        "bookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "chapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentType": {
          "const": "audio/uri"
        },
        "content": {
          "const": ""
        },
        "audio": {
          "$ref": "#/$defs/Audio"
        },
        "images": false,
        "contentVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
